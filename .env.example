# =============================================================================
# Tally — environment variables (TEMPLATE)
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must NEVER be committed. Only variables prefixed with VITE_ are exposed to the
# client bundle by Vite — never put service-role keys or other secrets here.
#
#   cp .env.example .env
# =============================================================================

# --- Supabase (client-safe) -------------------------------------------------
# Project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Public anon key (safe to ship to the browser; RLS protects the data)
VITE_SUPABASE_ANON_KEY=

# --- App configuration ------------------------------------------------------
# Single currency for v1 (ISO 4217), e.g. SGD, USD, EUR
VITE_DEFAULT_CURRENCY=SGD

# Group time zone used for "days unpaid" and month boundaries (IANA tz)
VITE_DEFAULT_TIMEZONE=Asia/Singapore

# =============================================================================
# NOTE: The Supabase service_role key bypasses RLS and is SERVER-ONLY. Do not
# add it here and do not expose it to the client. v1 has no custom server, so
# it should not be needed at all.
# =============================================================================
