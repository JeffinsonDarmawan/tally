# =============================================================================
# Tally — .gitignore
# Tuned for: Vite + React + TypeScript + Tailwind + Supabase + PWA + Vercel
# =============================================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build output ---
dist/
dist-ssr/
build/
*.local

# --- Vite / PWA generated ---
dev-dist/
.vite/
sw.js
workbox-*.js

# --- Test / coverage ---
coverage/
.nyc_output/
*.lcov

# --- Environment & secrets (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
.supabase/
supabase/.branches/
supabase/.temp/

# --- Vercel ---
.vercel/

# --- Editor / OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Misc ---
*.tsbuildinfo
.cache/
.eslintcache

# --- AI / agent tooling artifacts (never commit) ---
.claude/
.claude/**
.playwright-mcp/
CLAUDE.md
CLAUDE.local.md
.cursor/
.aider*
.continue/
.github/copilot-instructions.md
*.agent.local

